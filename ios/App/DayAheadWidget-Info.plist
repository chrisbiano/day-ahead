<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist for the widget extension.

  It lives OUTSIDE the DayAheadWidget folder on purpose. Xcode 16 targets use
  fileSystemSynchronizedGroups — every file in the folder is included in the
  target automatically — so an Info.plist in there gets copied as a resource AND
  processed as the Info.plist, and the build fails with "Multiple commands
  produce ... Info.plist". Moving it up one level is the fix; keep it here.

  Written out in full rather than generated, because GENERATE_INFOPLIST_FILE is
  off. The build-setting placeholders are filled in at build time.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Day Ahead</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
